#version 450
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

#include "rte.glsl"
#include "types.glsl"

#if defined(DATA_A_TQ4_0)
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 128;
shared float s_amax[4]; 

#elif defined(SET_ROWS) && QUANT_K == 1
layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 512;
#else
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 32;
#endif

layout (binding = 0) readonly buffer S {float data_s[];};

#if defined(SET_ROWS)
#include "generic_binary_head.glsl"
layout (binding = 1) readonly buffer C {B_TYPE data_i[];};
layout (binding = 2) writeonly buffer Q {A_TYPE data_q[];};
#else
#include "generic_unary_head.glsl"
layout (binding = 1) writeonly buffer Q {A_TYPE data_q[];};
#endif

#if defined(DATA_A_TQ4_0)
void quantize(uint dst_idx, uint src_idx) {
    const uint tid = gl_LocalInvocationID.x;
    const uint sgid = gl_SubgroupInvocationID;
    const uint swid = gl_SubgroupID;

    const float v = (tid < 128) ? data_s[src_idx + tid] : 0.0f;
    float amax = subgroupMax(abs(v));
    
    if (sgid == 0) {
        s_amax[swid] = amax;
    }
    
    barrier();
    
    float d_val;
    if (tid == 0) {
        float final_amax = 1e-10f;
        for (uint i = 0; i < 4; i++) {
            final_amax = max(final_amax, s_amax[i]);
        }
        d_val = final_amax / 7.5f;
        data_q[dst_idx].d = float16_t(d_val);
        for (uint i = 0; i < 16; i++) {
            data_q[dst_idx].qjl[i] = uint8_t(0);
        }
    }
    
    barrier();
    
    const float d = d_val;
    const float id = (d > 0.0f) ? 1.0f / d : 0.0f;
    
    uint qi = uint(clamp(floor(v * id + 8.0f), 0.0f, 15.0f));
    
    uint partner_qi = subgroupShuffle(qi, tid ^ 1);
    if ((tid & 1) == 0) {
        data_q[dst_idx].qs[tid/2] = uint8_t(qi | (partner_qi << 4));
    }
}
#endif

#if defined(DATA_A_Q4_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;
    for (int j = 0; j < QUANT_K_Q4_0; ++j) {
        const float v = data_s[src_idx + j];
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }
    const float d  = vmax / -8;
    const float id = (d != 0.0) ? 1.0/d : 0.0;
    data_q[dst_idx].d = float16_t(d);
    for (int j = 0; j < QUANT_K_Q4_0/2; ++j) {
        const float x0 = data_s[src_idx + 0              + j]*id;
        const float x1 = data_s[src_idx + QUANT_K_Q4_0/2 + j]*id;
        const uint xi0 = min(15, int(x0 + 8.5));
        const uint xi1 = min(15, int(x1 + 8.5));
        data_q[dst_idx].qs[j]  = uint8_t(xi0 | (xi1 << 4));
    }
}
#endif

#if defined(DATA_A_Q8_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    for (int j = 0; j < QUANT_K_Q8_0; j++) {
        const float v = data_s[src_idx + j];
        amax = max(amax, abs(v));
    }
    const float d = amax / 127.0f;
    const float id = (d != 0.0) ? 1.0/d : 0.0;
    data_q[dst_idx].d = float16_t(d);
    for (int j = 0; j < QUANT_K_Q8_0; ++j) {
        data_q[dst_idx].qs[j] = int8_t(round(data_s[src_idx + j]*id));
    }
}
#endif

#if defined(DATA_A_F32) || defined(DATA_A_F16)
void quantize(uint dst_idx, uint src_idx)
{
    data_q[dst_idx] = A_TYPE(data_s[src_idx]);
}
#endif

#if defined(DATA_A_BF16)
void quantize(uint dst_idx, uint src_idx)
{
    data_q[dst_idx] = A_TYPE(data_s[src_idx]);
}
#endif

#if defined(DATA_A_Q4_1)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0f;
    for (int j = 0; j < QUANT_K_Q4_1; ++j) {
        amax = max(amax, abs(data_s[src_idx + j]));
    }
    const float d = amax / -8.0f;
    const float id = (d != 0.0f) ? 1.0f / d : 0.0f;
    data_q[dst_idx].d = float16_t(d);
    for (int j = 0; j < QUANT_K_Q4_1/2; ++j) {
        const float x0 = data_s[src_idx + 0 + j] * id;
        const float x1 = data_s[src_idx + QUANT_K_Q4_1/2 + j] * id;
        const uint xi0 = min(15, int(x0 + 8.5f));
        const uint xi1 = min(15, int(x1 + 8.5f));
        data_q[dst_idx].qs[j] = uint8_t(xi0 | (xi1 << 4));
    }
}
#endif

